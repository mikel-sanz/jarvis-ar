# Configuración del Asistente Jarvis AR
# Clave de API para Gemini Vision (Opcional: Si se deja vacía, el sistema usa el motor analítico local)
GEMINI_API_KEY=

# Parámetros del Servidor Web
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Parámetros de Cámara y AR
CAMERA_INDEX=0
AR_HUD_THEME=CYAN
AR_CONFIDENCE_THRESHOLD=0.5
